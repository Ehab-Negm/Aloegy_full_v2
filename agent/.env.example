LIVEKIT_URL=wss://your-livekit-url.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
OPENAI_API_KEY=your-openai-api-key
CARTESIA_API_KEY=your-cartesia-api-key
DEEPGRAM_API_KEY=your-deepgram-api-key
ELEVEN_API_KEY=your-eleven-api-key
GOOGLE_API_KEY=your-google-api-key
XAI_API_KEY=your-xai-api-key
HAMSA_API_KEY=your-hamsa-api-key
APP_ENV=prod
SONIOX_API_KEY=your-soniox-api-key

# ── Backend ──────────────────────────────────────────
BACKEND_BASE_URL=http://localhost:8000
BACKEND_API_KEY=your-backend-api-key

# ── Fallback ─────────────────────────────────────────
RESTAURANT_FALLBACK_NAME=your-restaurant-name
RESTAURANT_FALLBACK_PHONE=your-restaurant-phone

# ── Tuning (optional) ────────────────────────────────
LOG_LEVEL=INFO
CONFIG_CACHE_TTL=60
MAX_CALL_DURATION=600
SESSION_LLM_MODEL=gemini-2.5-flash
# Alternative examples:
# SESSION_LLM_MODEL=gemini-2.5-flash-lite
# SESSION_LLM_MODEL=gemini-2.5-pro
# SESSION_LLM_MODEL=gpt-5.4-mini
SESSION_LLM_TEMPERATURE=0.85
SESSION_LLM_TOP_P=0.95
# 0 = instant response (no thinking). Raise to 256-1024 for harder reasoning at the cost of latency.
SESSION_LLM_THINKING_BUDGET=0
SESSION_STT_LANGUAGE=ar
SESSION_STT_LANGUAGE_HINTS_STRICT=true
SESSION_STT_MODEL=stt-rt-v4
SESSION_STT_BASE_URL=wss://stt-rt.soniox.com/transcribe-websocket

# ── Hamsa TTS ─────────────────────────────────────────
# Speakers: Amjad, Lyali, Salma, Mariam, Dalal, Lana, Jasem, Samir, Carla, Nada
# Dialects: egy, msa, ksa, uae, leb, syr, jor, irq, qat, bah, pls
SESSION_TTS_VOICE=Salma
SESSION_TTS_DIALECT=egy
SESSION_TTS_LANGUAGE=ar
SESSION_TTS_MULAW=false
