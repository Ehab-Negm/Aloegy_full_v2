LIVEKIT_URL=wss://your-livekit-url.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
OPENAI_API_KEY=your-openai-api-key
CARTESIA_API_KEY=your-cartesia-api-key
DEEPGRAM_API_KEY=your-deepgram-api-key
ELEVEN_API_KEY=your-eleven-api-key
GOOGLE_API_KEY=your-google-api-key
XAI_API_KEY=your-xai-api-key
HAMSA_API_KEY=your-hamsa-api-key
APP_ENV=prod
SONIOX_API_KEY=your-soniox-api-key

# ── Backend ──────────────────────────────────────────
BACKEND_BASE_URL=http://localhost:8000
BACKEND_API_KEY=your-backend-api-key

# ── Fallback ─────────────────────────────────────────
RESTAURANT_FALLBACK_NAME=your-restaurant-name
RESTAURANT_FALLBACK_PHONE=your-restaurant-phone

# ── Tuning (optional) ────────────────────────────────
LOG_LEVEL=INFO
CONFIG_CACHE_TTL=60
MAX_CALL_DURATION=600
SESSION_LLM_MODEL=gpt-4o
# Alternative examples:
# SESSION_LLM_MODEL=gemini-2.5-flash
# SESSION_LLM_MODEL=gemini-2.5-flash-lite
# SESSION_LLM_MODEL=gemini-2.5-pro
# SESSION_LLM_MODEL=gpt-4o-mini
SESSION_LLM_MAX_COMPLETION_TOKENS=260
SESSION_LLM_TEMPERATURE=0.25
SESSION_LLM_TOP_P=0.85
PROMPT_HISTORY_ITEMS=12
TURN_CHAT_CTX_MAX_ITEMS=36
# 0 = instant response (no thinking). Raise to 256-1024 for harder reasoning at the cost of latency.
SESSION_LLM_THINKING_BUDGET=0
SESSION_STT_LANGUAGE=ar
SESSION_STT_LANGUAGE_HINTS_STRICT=true
SESSION_STT_MODEL=stt-rt-v4
SESSION_STT_BASE_URL=wss://stt-rt.soniox.com/transcribe-websocket
# STT provider A/B (Phase 1.2). Default Soniox; flip the percent to route
# a fraction of calls to Deepgram Nova-3 with menu-keyterm prompting.
SESSION_STT_PROVIDER=soniox
SESSION_STT_DEEPGRAM_AB_PERCENT=0
SESSION_STT_DEEPGRAM_MODEL=nova-3
SESSION_STT_DEEPGRAM_LANGUAGE=multi
SESSION_STT_DEEPGRAM_ENDPOINTING_MS=200

# ── Realtime mode (Gemini Live) ──────────────────────
# Set SESSION_REALTIME_ENABLED=1 to use Gemini 3.1 Flash Live as a single
# audio-in / audio-out model (replaces STT + LLM + TTS). Tools still work.
# Note: 3.1 rejects mid-call instruction/context updates, so persona handoff
# between flows degrades to tool-mediated state — keep one comprehensive
# instruction set in SESSION_REALTIME_INSTRUCTIONS.
SESSION_REALTIME_ENABLED=0
SESSION_REALTIME_MODEL=gemini-3.1-flash-live-preview
SESSION_REALTIME_VOICE=Aoede
SESSION_REALTIME_LANGUAGE=ar-EG
SESSION_REALTIME_TEMPERATURE=0.6
SESSION_REALTIME_INSTRUCTIONS=You are a friendly Egyptian-Arabic restaurant phone agent. Speak only in natural Cairo Arabic, like a human waiter — never English. Greet the caller, find out if they want takeaway, delivery, reservation, or have a complaint, then collect what's needed and confirm the order back to them. Use the tools to record name, phone, address, and order items as soon as the caller says them. Keep replies short, warm, and concrete.

# ── TTS ──────────────────────────────────────────────
# Default: Gemini 3.1 Flash TTS (Preview) via GOOGLE_API_KEY.
#   SESSION_TTS_MODEL=gemini-3.1-flash-tts-preview
#   SESSION_TTS_VOICE=Aoede   # Gemini voices: Aoede, Kore, Sulafat, Charon, ...
#   SESSION_TTS_INSTRUCTIONS=Speak in clear Egyptian Arabic ...
# Hamsa fallback (Arabic-native): SESSION_TTS_MODEL=hamsa
#   Speakers: Amjad, Lyali, Salma, Mariam, Dalal, Lana, Jasem, Samir, Carla, Nada
#   Dialects: egy, msa, ksa, uae, leb, syr, jor, irq, qat, bah, pls
SESSION_TTS_MODEL=gemini-3.1-flash-tts-preview
SESSION_TTS_VOICE=Aoede
SESSION_TTS_INSTRUCTIONS=Speak in clear Egyptian Arabic (Cairo dialect) with a warm, friendly customer-service tone. Don't add or omit any words.
SESSION_TTS_DIALECT=egy
SESSION_TTS_LANGUAGE=ar
SESSION_TTS_MULAW=false
# Phase 1.3 — Azure ar-EG TTS A/B (set percent above zero to enable).
SESSION_TTS_AZURE_AB_PERCENT=0
SESSION_TTS_AZURE_VOICE=ar-EG-SalmaNeural
# AZURE_SPEECH_KEY=your-azure-speech-key
# AZURE_SPEECH_REGION=eastus
