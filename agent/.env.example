LIVEKIT_URL=wss://your-livekit-url.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_AGENT_NAME=aloegy-agent
OPENAI_API_KEY=your-openai-api-key
GROQ_API_KEY=your-groq-api-key
CARTESIA_API_KEY=your-cartesia-api-key
DEEPGRAM_API_KEY=your-deepgram-api-key
ELEVEN_API_KEY=your-eleven-api-key
GOOGLE_API_KEY=your-google-api-key
XAI_API_KEY=your-xai-api-key
HAMSA_API_KEY=your-hamsa-api-key
APP_ENV=prod
SONIOX_API_KEY=your-soniox-api-key

# ── Backend ──────────────────────────────────────────
BACKEND_BASE_URL=http://localhost:8000
BACKEND_API_KEY=your-backend-api-key

# ── Fallback ─────────────────────────────────────────
RESTAURANT_FALLBACK_NAME=your-restaurant-name
RESTAURANT_FALLBACK_PHONE=your-restaurant-phone

# ── Tuning (optional) ────────────────────────────────
LOG_LEVEL=INFO
CONFIG_CACHE_TTL=60
CONFIG_FETCH_TOTAL_BUDGET_SECONDS=1.5
MAX_CALL_DURATION=600
TARGET_E2E_FIRST_AUDIO_MS=600
TELEMETRY_LOG_PATH=.runtime/prod/telemetry.jsonl
QA_TRANSCRIPT_EVENTS_ENABLED=true
CALL_METRICS_PATH=.runtime/prod/call_metrics.jsonl
AGENT_HEALTH_HEARTBEAT_SECONDS=30
# Low-latency production candidate for Egyptian Arabic + function calling.
SESSION_LLM_MODEL=gemini-3.1-flash-lite
SESSION_LLM_USE_VERTEXAI=true
SESSION_LLM_LOCATION=global
# Alternative examples:
# SESSION_LLM_MODEL=gemini-2.5-flash
# SESSION_LLM_MODEL=gpt-4.1-mini
# SESSION_LLM_MODEL=groq/allam-2-7b
# SESSION_LLM_MODEL=cerebras/qwen-3-32b
MIN_ENDPOINTING_DELAY_SECONDS=0.12
MAX_ENDPOINTING_DELAY_SECONDS=0.35
FALSE_INTERRUPTION_TIMEOUT_SECONDS=0.25
AEC_WARMUP_DURATION_SECONDS=0.8
SESSION_LLM_TEMPERATURE=0.25
SESSION_LLM_TOP_P=0.95
SESSION_LLM_MAX_COMPLETION_TOKENS=64
# 0 = instant response (no thinking). Raise to 256-1024 for harder reasoning at the cost of latency.
SESSION_LLM_THINKING_BUDGET=0
SESSION_PREEMPTIVE_GENERATION=true
# Inbound LiveKit Cloud noise cancellation before STT.
# bvc_telephony is the production default for SIP/phone calls.
# Use bvc for web/app single-speaker voice isolation, nc for general noise,
# or off to disable during troubleshooting/upstream audio filtering.
SESSION_NOISE_CANCELLATION=bvc_telephony
# Non-blocking second-LLM reviewer. Keep disabled for launch unless you are
# sampling QA calls; it runs after replies are sent and consumes separate LLM quota.
ACTION_REVIEW_ENABLED=false
ACTION_REVIEW_MODEL=gpt-4.1-mini
ACTION_REVIEW_API_KEY=
ACTION_REVIEW_TIMEOUT_SECONDS=2.5
ACTION_REVIEW_MAX_CONCURRENCY=2
ACTION_REVIEW_SAMPLE_RATE=0.1
SESSION_STT_LANGUAGE=ar
SESSION_STT_LANGUAGE_HINTS_STRICT=true
SESSION_STT_ENABLE_LANGUAGE_IDENTIFICATION=false
SESSION_STT_MAX_ENDPOINT_DELAY_MS=500
SESSION_STT_MODEL=stt-rt-v4
SESSION_STT_BASE_URL=wss://stt-rt.soniox.com/transcribe-websocket

# ── Realtime mode (Gemini 3.1 Flash Live) ───────────────
# Replaces SESSION_STT_* / SESSION_TTS_* / SESSION_LLM_* with one unified
# speech-to-speech model that handles audio in, dialogue, tools, and audio out.
# Toggle with SESSION_REALTIME_ENABLED (defaults on when SESSION_REALTIME_MODEL
# is set). Authentication: GOOGLE_API_KEY (Gemini API) — or set
# SESSION_REALTIME_USE_VERTEX=true and use GOOGLE_APPLICATION_CREDENTIALS.
# Voices: Puck (default, neutral), Charon, Kore, Fenrir, Aoede, Leda, Orus, Zephyr.
SESSION_REALTIME_ENABLED=0
SESSION_REALTIME_MODEL=
# SESSION_REALTIME_MODEL=gemini-3.1-flash-live-preview
SESSION_REALTIME_VOICE=Puck
SESSION_REALTIME_LANGUAGE=ar-EG
SESSION_REALTIME_TEMPERATURE=0.6
SESSION_REALTIME_USE_VERTEX=false

# ── Hamsa TTS ─────────────────────────────────────────
# Speakers: Amjad, Lyali, Salma, Mariam, Dalal, Lana, Jasem, Samir, Carla, Nada
# Dialects: egy, msa, ksa, uae, leb, syr, jor, irq, qat, bah, pls
SESSION_TTS_MODEL=cloud-tts/chirp3-hd
SESSION_TTS_VOICE=ar-XA-Chirp3-HD-Sulafat
SESSION_TTS_DIALECT=egy
SESSION_TTS_LANGUAGE=ar-XA
SESSION_TTS_LOCATION=global
SESSION_TTS_MULAW=false
SESSION_TTS_STREAMING_ENABLED=true
GEMINI_TTS_PREROLL_ENABLED=false
GEMINI_TTS_INSTANT_ACK_ENABLED=false
GEMINI_TTS_PREROLL_PATH=assets/tts_cache/gemini_3_1_leda_ar_eg_tamam.pcm
TTS_WARMUP_JOIN_TIMEOUT_SECONDS=1.0
TTS_WARMUP_PROVIDER_TIMEOUT_SECONDS=2.0
