# ── Tuning (اختياري) ─────────────────────────────────
LOG_LEVEL=INFO                # DEBUG / INFO / WARNING
CONFIG_CACHE_TTL=300          # ثواني — cache config per restaurant
MAX_CALL_DURATION=600         # ثواني — أقصى مدة مكالمة (default 10 دقايق)
# LLM choice (Phase 1.1 — production plan):
#
# Default: gpt-4o-mini direct via OPENAI_API_KEY.
#   • Reliable function-calling (Qwen3-32B was hit-or-miss on OpenRouter).
#   • TTFT ~300-500ms (vs Qwen3-32B with thinking ~7s, /no_think ~1.1s).
#   • $0.15/$0.60 per M tokens — cheap enough that the 70%-of-turns
#     deterministic pipeline keeps spend negligible.
#   • Egyptian dialect: "good but not specialized" — acceptable for the
#     LLM-fallback paraphrase path (see plan §1.1, alternatives evaluated).
#
# Alternatives wired in agent.py:457-538 — change SESSION_LLM_MODEL only:
#   OpenAI direct: gpt-4o-mini, gpt-4o, o1-mini, o3-mini, gpt-5-mini, …
#   OpenRouter:    qwen/qwen3-32b, anthropic/claude-3.5-haiku,
#                  google/gemini-2.5-flash-lite, meta-llama/llama-3.3-70b-instruct
#   Google direct: gemini-2.5-flash, gemini-2.5-pro
#
# OpenRouter routing kicks in automatically when the model contains "/"
# AND OPENROUTER_API_KEY is set (kept above for ops experiments).
SESSION_LLM_MODEL=gpt-4.1-mini
# Lowered from 512 → 200: agent answers are short (<20 words ≈ 50 tokens).
# 512 gave the LLM room to ramble and added latency. 200 fits even the
# longest 'confirm_and_submit' return + reply with comfort margin.
SESSION_LLM_MAX_COMPLETION_TOKENS=200
SESSION_LLM_TEMPERATURE=0.25
SESSION_LLM_TOP_P=0.85
# Unused for OpenAI LLMs; kept for the Gemini fallback if you switch back.
SESSION_LLM_THINKING_BUDGET=0
# preemptive=true is invalidated every turn by our [CALL_STATE] system
# message injection in on_user_turn_completed. The warning
# "preemptive generation enabled but chat context or tools have changed"
# means the work was wasted. Until we move state injection to a non-
# invalidating path, keeping it false avoids the wasted LLM call.
SESSION_PREEMPTIVE_GENERATION=false
# LLM understanding extractor is DISABLED. The realtime Gemini model owns
# the conversation when SESSION_REALTIME_ENABLED=1, and the regex-based
# Phase 2 extractor handles data capture. Re-enable with
# LLM_UNDERSTANDING_ENABLED=1 if you switch back to non-realtime mode.
LLM_UNDERSTANDING_ENABLED=0
UNDERSTANDING_MODEL=gemini-2.5-flash
UNDERSTANDING_TEMPERATURE=0.05
UNDERSTANDING_MAX_TOKENS=1024
# History trimming — reduced from 12/36 (multi-agent legacy) to 6/16.
# Single-agent design re-injects a fresh [CALL_STATE] system message every
# turn with all captured slots, so the LLM doesn't need a long chat history
# to remember what the customer said. Smaller prompts = faster TTFT + cheaper.
PROMPT_HISTORY_ITEMS=6
TURN_CHAT_CTX_MAX_ITEMS=10
MIN_INTERRUPTION_DURATION_SECONDS=0.5
MIN_ENDPOINTING_DELAY_SECONDS=0.35
MAX_ENDPOINTING_DELAY_SECONDS=0.7
FALSE_INTERRUPTION_TIMEOUT_SECONDS=0.6
MAX_TOOL_STEPS=3
NO_SPEECH_PROMPT_SECONDS=18
CONFIG_FETCH_TOTAL_BUDGET_SECONDS=0.6
AGENT_IDLE_PROCESSES=1
# ── Pipeline mode (chosen) ───────────────────────────────────────────────────
#   User audio → Soniox STT → Gemini 2.5 Flash LLM → Gemini 3.1 Flash TTS
# Realtime is OFF: keeps the multi-agent handoff architecture (Greeter →
# Delivery / Takeaway / Reservation / Complaint) working as designed and uses
# 3.1 only where it actually fits — the high-quality TTS path. The realtime
# block below is left configured so flipping back is one line.
SESSION_REALTIME_ENABLED=0
# Gemini 3.1 Flash Live is fundamentally incompatible with multi-agent
# handoff architecture: it rejects update_instructions / update_chat_ctx /
# generate_reply, has no proactivity, and uses synchronous tool calling.
# Switched to 2.5 Live native audio — same audio-native anti-hallucination
# benefits, but all LiveKit handoff/tool methods work as designed.
SESSION_REALTIME_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
SESSION_REALTIME_VOICE=Aoede
SESSION_REALTIME_LANGUAGE=ar-EG
SESSION_REALTIME_TEMPERATURE=0.6
SESSION_REALTIME_INSTRUCTIONS=أنت موظف مصري بترد على تليفون مطعم كشري التحرير. اتكلم بس باللهجة المصرية القاهرية، زي راجل حقيقي مش بوت. متستخدمش إنجليزي أبداً. خطوات المكالمة: (1) سلّم على الزبون باسم المطعم. (2) اسأله عايز تكلَيمي/توصيل/حجز/شكوى — وحوّله للـ flow المناسب باستخدام to_takeaway / to_delivery / to_reservation / to_complaint. (3) خد منه الاسم والتليفون والعنوان (لو توصيل) والطلب — واحدة واحدة، وكل ما يقولك حاجة استخدم الـ tool المناسب فوراً (update_name، update_phone، update_address، update_order). (4) بعد كل tool call، أكِّد للزبون اللي سجلته في جملة قصيرة بالعربي — الزبون مش هيسمع تأكيد لو إنت مأكدتش. مثال: "تمام، اتسجلت بيتزا مارجريتا، الإجمالي مية وعشرين جنيه — تحب تضيف حاجة تانية؟". (5) لما الطلب يكتمل، اقفله بـ submit_order أو submit_reservation. قواعد الكلام: جملة واحدة قصيرة (أقصى 15 كلمة)، ابدأ بكلمة تأكيد صغيرة (تمام/ماشي/حاضر/اه)، قول "يا فندم" مرة أو اتنين فقط في المكالمة كلها، متكررش كلام الزبون حرفي، مش فاهم قول "معلش، ممكن تعيدها؟" متخمّنش، لو الـ tool واخد وقت قول "ثانية بس" بدل ما تسكت.

# TTS: Gemini 3.1 Flash *Live* API as TTS-only (text in → streaming PCM
# audio frames out via websocket). Target: <600 ms ttfb.
#
# Why the Live API path:
#   The classic Gemini speech-generation REST endpoint
#   (ai.google.dev/gemini-api/docs/speech-generation) explicitly states
#   "TTS does not support streaming" — every synth buffers the full
#   clip → ~2.5s ttfb. Wrong trade for a phone agent. The Live API IS
#   streaming (PCM frames arrive as the model emits them) and the 3.1
#   Live preview model is reachable via GOOGLE_API_KEY.
#
# Routing (model-name based, picked by `_build_base_session_tts`):
#   - "gemini-...-live..."     → Gemini Live API (streaming, fastest)
#                                handled by agent/gemini_live_tts.py
#   - "gemini-2.5-flash-tts"   → Cloud TTS streaming (needs service acct)
#   - other "gemini-..."       → Cloud TTS streaming if creds set, else
#                                beta.GeminiTTS non-streaming fallback
#   - "hamsa..."               → Hamsa Cloud TTS
#   - "xai..."                 → xAI TTS
#
# Voices (Gemini, 30 multilingual): Aoede, Kore, Sulafat, Charon, Puck,
#   Zephyr, Fenrir, Leda, Orus, Callirrhoe, Autonoe, Enceladus, Iapetus,
#   Umbriel, Algieba, Despina, Erinome, Algenib, Rasalgethi, Laomedeia,
#   Achernar, Alnilam, Schedar, Gacrux, Pulcherrima, Achird,
#   Zubenelgenubi, Vindemiatrix, Sadachbia, Sadaltager.
#   Aoede / Kore / Sulafat = warm female; Charon / Orus = male.
#
# Falling back: if the Live preview is rejected (region / quota), swap
# to `gemini-2.5-flash-tts` (Cloud TTS streaming, GA).
# NOTE: gemini-3.1-flash-live-preview opens the websocket fine but never
# emits audio for our text-in/audio-out config (8s receive timeout, all
# attempts). Falling back to the 2.5 native-audio preview, which is
# known-good with this same code path. Re-test 3.1 by flipping back when
# the preview is actually responsive.
# Production TTS = Google Cloud TTS streaming with Chirp3-HD voice.
#
# Why this and not Gemini 3.1 Flash TTS preview:
#   The Gemini TTS preview API (`gemini-3.1-flash-tts-preview`) is
#   non-streaming per Google's own docs — it has to generate the full
#   audio clip server-side before returning anything, so for a 121-char
#   verification readback we measured 5963ms TTFB. The Chirp3-HD voices
#   on Cloud TTS are the SAME Gemini-trained voices (Aoede, Sulafat,
#   Charon, Kore, ...) but delivered via the GA streaming endpoint —
#   measured 410-1238ms TTFB on the same hardware/network, ~4-5x faster.
#
# Auth: uses the service-account JSON pointed at by
# GOOGLE_APPLICATION_CREDENTIALS (above). agent._build_base_session_tts
# detects "chirp" in the model name and routes to livekit.plugins.google.TTS
# with the JSON credentials and LINEAR16 encoding (the encoding Chirp3-HD
# requires; the default PCM_24000 is rejected with HTTP 400).
#
# Voice menu (all use ar-XA): Chirp3-HD-Aoede, Chirp3-HD-Sulafat,
#   Chirp3-HD-Kore (warm female), Chirp3-HD-Charon, Chirp3-HD-Orus,
#   Chirp3-HD-Puck (male). Sulafat is warmest female on Egyptian Arabic.
#
# Fallback to the slower-but-stable Gemini 3.1 path: change SESSION_TTS_MODEL
# back to "gemini-3.1-flash-tts-preview" — same JSON auth still works.
SESSION_TTS_MODEL=cloud-tts/chirp3-hd
SESSION_TTS_VOICE=ar-XA-Chirp3-HD-Sulafat
SESSION_TTS_LANGUAGE=ar-XA
# SESSION_TTS_LOCATION=global       # Cloud TTS region; default 'global'
SESSION_TTS_MAX_TURNS_PER_SESSION=20
SESSION_TTS_STREAMING_ENABLED=true
SESSION_TTS_STREAM_PACING=false
# SESSION_TTS_INSTRUCTIONS — Gemini-Live-only directive (the model
# accepts a system prompt for voice direction). Hamsa doesn't read this,
# so it's commented out under the Hamsa default. Uncomment if you switch
# back to Gemini Live.
# SESSION_TTS_INSTRUCTIONS=You are voicing a warm, friendly Egyptian male restaurant phone employee in Cairo. Speak ONLY in everyday Cairo Egyptian Arabic — never Modern Standard Arabic, never English. Sound like a real human waiter on the phone: natural intonation, unhurried pace, soft pauses between phrases, slight rising tone on questions. Pronounce numbers and prices the Egyptian way ("مية وعشرين جنيه" not "مائة وعشرون جنيهاً"; "اتنين" not "اثنان"; "تلاتة" not "ثلاثة"). Drop final hamzas and case endings as Cairene speakers do. Keep tone warm and confident. Read the text exactly — don't add filler words, don't skip anything, don't translate.

SESSION_TTS_DIALECT=egy
SESSION_TTS_MULAW=false
# Phase 1.3 — Azure ar-EG TTS A/B branch (SalmaNeural / ShakirNeural).
# Set the percent above zero to route a fraction of calls to Azure.
# Requires AZURE_SPEECH_KEY + AZURE_SPEECH_REGION. Voice defaults to
# ar-EG-SalmaNeural (female, MOS ~4.3 on Cairo dialect — the best
# native Egyptian voice we found). Use ar-EG-ShakirNeural for male.
SESSION_TTS_AZURE_AB_PERCENT=0
SESSION_TTS_AZURE_VOICE=ar-EG-SalmaNeural
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastus

# Phase 2.1 — Mid-speech backchannel emitter. Default OFF. Flip to 1
# to fire short Egyptian acknowledgements ("اه" / "تمام" / "ماشي") while
# the customer is still speaking past the threshold. Plan §2.1 caps to
# 1 backchannel per 4s and suppresses while the agent itself is talking.
# Worker-startup config prewarm — populate the in-memory + shared file
# cache in a background thread so the first call hits a warm cache
# instead of paying the 1-1.5s backend round-trip.
# (No TTS prewarm — gRPC channel can't be shared across event loops.)
CONFIG_PREWARM_ENABLED=1

BACKCHANNEL_EMITTER_ENABLED=0
BACKCHANNEL_MIN_SPEECH_SECONDS=1.5
BACKCHANNEL_MIN_GAP_SECONDS=4.0

# Phase 4.2 — per-call cost estimate. Default rates = GPT-4o-mini list price.
# Tune to match whichever LLM/TTS/STT the deployment ships with.
COST_LLM_INPUT_PER_1M_USD=0.15
COST_LLM_OUTPUT_PER_1M_USD=0.60
COST_TTS_PER_1M_CHARS_USD=16.0
COST_STT_PER_MINUTE_USD=0.0036

# Phase 3.2 — provider fallback chains (livekit FallbackAdapter).
# STT: when enabled, the STT used per call is wrapped so that if the
# chosen provider 5xxs or times out, the call automatically retries on
# the *other* provider (whichever has a working API key).
SESSION_STT_FALLBACK_ENABLED=0
# LLM: set FALLBACK_MODEL to a backup model id for retry on 5xx/timeout.
# Provider hint is optional — auto-routed by model-id prefix otherwise.
SESSION_LLM_FALLBACK_MODEL=
SESSION_LLM_FALLBACK_PROVIDER=
SESSION_STT_LANGUAGE=ar
SESSION_STT_LANGUAGE_HINTS_STRICT=true
SESSION_STT_MODEL=stt-rt-v4
SESSION_STT_BASE_URL=wss://stt-rt.soniox.com/transcribe-websocket
# Phase 1.2 — STT provider A/B (soniox is the production primary).
# Flip to "deepgram" to send every call to Nova-3, or keep "soniox" and
# raise SESSION_STT_DEEPGRAM_AB_PERCENT to route a fraction of calls to
# Deepgram for comparison (telemetry tags every turn with the actual
# provider used). Deepgram Nova-3 receives the menu + branch + zone
# names as keyterm prompts to bias recognition toward in-domain terms.
SESSION_STT_PROVIDER=soniox
SESSION_STT_DEEPGRAM_AB_PERCENT=0
SESSION_STT_DEEPGRAM_MODEL=nova-3
SESSION_STT_DEEPGRAM_LANGUAGE=multi
SESSION_STT_DEEPGRAM_ENDPOINTING_MS=200

OPENROUTER_API_KEY=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
