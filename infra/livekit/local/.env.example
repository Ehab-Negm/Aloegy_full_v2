# Copy to .env, fill in PUBLIC_IP and the LiveKit keys.
# .env is gitignored — never commit the populated version.

# Your Windows LAN IP — what Issabel will dial.
# Find it: ipconfig | findstr /C:"IPv4 Address"
# Pick the address on the same /24 as Issabel.
PUBLIC_IP=192.168.8.5

# Random keys for local testing — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-replace-with-32-byte-hex
