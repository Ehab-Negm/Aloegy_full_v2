# Copy to `.env` next to docker-compose.yml on the VPS. NEVER commit the
# populated version to git — these creds let any holder send to the LiveKit
# room and create dispatch rules.

# Generate fresh: `python -c "import secrets; print(secrets.token_hex(32))"`
LIVEKIT_API_KEY=replace-me-64-hex-chars
LIVEKIT_API_SECRET=replace-me-64-hex-chars

# VPS public IPv4 — used by livekit-sip to advertise itself in SDP offers.
# Must match the A-record for SIP_DOMAIN.
PUBLIC_IP=203.0.113.10

# DNS records (point both at PUBLIC_IP).
LIVEKIT_DOMAIN=livekit.aloegy.ai
SIP_DOMAIN=sip.aloegy.ai

# Let's Encrypt registration email for Caddy. Receives expiry warnings.
ACME_EMAIL=ops@aloegy.ai
