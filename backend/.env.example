APP_ENV=dev
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_API_KEY=your-backend-api-key
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Optional dev-only OTP shortcut. Never set this in prod.
# DEV_OTP_BYPASS=956956
# Optional in development. Leave unset to use local SQLite automatically.
# DATABASE_URL=postgresql://user:password@host:port/dbname
